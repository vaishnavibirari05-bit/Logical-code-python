### 6. Multiplication Table
```python
num = 5
i = 1

while i <= 10:
    print(num, "x", i, "=", num * i)
    i += 1
```

### 7. Reverse a Number
```python
num = 12345
rev = 0

while num > 0:
    digit = num % 10
    rev = rev * 10 + digit
    num //= 10

print(rev)
```

### 8. Count Digits
```python
num = 12345
count = 0

while num > 0:
    count += 1
    num //= 10

print(count)
```

### 9. Sum of Digits
```python
num = 1234
total = 0

while num > 0:
    total += num % 10
    num //= 10

print(total)
```

### 10. Check Palindrome Number
```python
num = 121
temp = num
rev = 0

while num > 0:
    rev = rev * 10 + num % 10
    num //= 10

if temp == rev:
    print("Palindrome")
else:
    print("Not Palindrome")
```

### 11. Factorial of a Number
```python
num = 5
fact = 1

while num > 0:
    fact *= num
    num -= 1

print(fact)
```

### 12. Fibonacci Series
```python
a = 0
b = 1
i = 1

while i <= 10:
    print(a)
    a, b = b, a + b
    i += 1
```

### 13. Check Prime Number
```python
num = 7
i = 2
count = 0

while i < num:
    if num % i == 0:
        count += 1
    i += 1

if count == 0 and num > 1:
    print("Prime")
else:
    print("Not Prime")
```

### 14. Check Armstrong Number
```python
num = 153
temp = num
total = 0

while num > 0:
    digit = num % 10
    total += digit ** 3
    num //= 10

if temp == total:
    print("Armstrong")
else:
    print("Not Armstrong")
```

### 15. Reverse a String
```python
s = "Python"
rev = ""
i = len(s) - 1

while i >= 0:
    rev += s[i]
    i -= 1

print(rev)
```

